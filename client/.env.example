# Base URL of the REST API. Use a relative path when the client proxies /api to the backend
# (Vite dev server locally, Vercel rewrites in production).
VITE_API_URL=/api/v1

# Socket.io origin. Leave empty to use the current origin (Vite proxies /socket.io in development).
# In production set this to the backend origin, e.g. https://nichelink-api.onrender.com
VITE_SOCKET_URL=
