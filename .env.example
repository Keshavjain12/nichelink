# Variables read by docker-compose.yml. Copy to .env next to docker-compose.yml and edit:
#   cp .env.example .env
# The API container runs with NODE_ENV=production, so the two required values have no fallbacks.

# Required, at least 32 characters (the placeholder is deliberately too short to boot). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-random-bytes

# Required. Origin of the SPA that calls this API (CORS, cookies and Stripe redirects).
CLIENT_URL=http://localhost:5173

# Optional: image uploads are disabled while these are empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: payments are disabled while these are empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
