# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/nichelink

# ─── Web client / CORS ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
# Optional extra comma-separated origins (e.g. Vercel preview URLs)
CORS_ORIGINS=
# Number of proxy hops in front of the API (Render/Heroku: 1)
TRUST_PROXY=0

# ─── Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax when the client proxies /api through its own domain; none (+ COOKIE_SECURE=true) for cross-site
COOKIE_SAMESITE=lax
# Defaults to true in production
COOKIE_SECURE=false

RATE_LIMIT_ENABLED=true

# ─── Cloudinary (optional — image uploads are disabled when unset) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Stripe test mode (optional — payments are disabled when unset) ─────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── Seed script (development only) ─────────────────────────────────────────
SEED_DEMO_PASSWORD=
